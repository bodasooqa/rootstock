{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(rustfmt *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(jq *)",
      "Bash(openspec status *)",
      "Bash(openspec instructions *)",
      "Bash(openspec list *)",
      "Bash(openspec show *)",
      "Bash(openspec validate *)",
      "Bash(openspec schemas *)",
      "Bash(openspec templates *)",
      "Bash(openspec context *)",
      "Bash(openspec doctor *)",
      "Bash(openspec store list *)",
      "Bash(openspec new change *)",
      "Bash(openspec change *)",
      "Bash(openspec spec *)",
      "Bash(openspec archive *)",
      "Bash(lefthook validate)",
      "Bash(shellcheck *)"
    ],
    "deny": [
      "Bash(rg *--pre*)",
      "Bash(git diff *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--output*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--output*)",
      "Bash(git show *--ext-diff*)",
      "Bash(cargo *--config*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/commands/opsx/**)",
      "Edit(./.claude/skills/openspec-**)",
      "Edit(./.pi/prompts/opsx-*)",
      "Edit(./.pi/skills/openspec-**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" session-end",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" pre-bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" pre-handback",
            "timeout": 600,
            "statusMessage": "executor checks on affected packages"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "-developer$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" subagent-stop",
            "timeout": 600,
            "statusMessage": "executor checks on affected packages"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" post-edit",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" post-edit-async",
            "timeout": 300,
            "async": true,
            "asyncRewake": true,
            "statusMessage": "clippy on the affected crate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" post-bash",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
